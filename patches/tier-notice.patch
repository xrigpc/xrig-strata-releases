From c1c3c5a1339b59a90975f1e4908f150b809f6495 Mon Sep 17 00:00:00 2001
From: office <office@localhost>
Date: Wed, 21 Oct 2026 17:25:41 +0530
Subject: [PATCH] tier-notice: one line when the daily write budget engages /
 frees; refusals logged 1 in 100 (log only)

---
 include/strata/core/conversation_disk.hpp |  8 +++-
 src/core/conversation_disk.cpp            | 54 ++++++++++++++++++++---
 src/core/conversation_disk_test.cpp       | 22 ++++++++-
 3 files changed, 73 insertions(+), 11 deletions(-)

diff --git a/include/strata/core/conversation_disk.hpp b/include/strata/core/conversation_disk.hpp
index 480fe8aa..086d034f 100644
--- a/include/strata/core/conversation_disk.hpp
+++ b/include/strata/core/conversation_disk.hpp
@@ -180,10 +180,14 @@ private:
     std::thread thread_;
     ConversationDiskStats stats_;
     /// xrig tier fix: the write gate (call with m_ held).  Null when the conversation may be queued (it is then
-    /// counted against the daily budget), else why it is not written.
-    const char* write_gate(const ConversationCheckpoint& live, bool cvec, uint64_t bytes);
+    /// counted against the daily budget), else why it is not written.  `note` gets a one-time notice to log after
+    /// unlocking (the daily budget reached, or room again); `quiet` is set for a refusal not worth its own line.
+    const char* write_gate(const ConversationCheckpoint& live, bool cvec, uint64_t bytes, std::string& note,
+                           bool& quiet);
     std::deque<std::pair<std::chrono::steady_clock::time_point, uint64_t>> day_writes_;   ///< queued bytes, last 24 h
     uint64_t day_bytes_ = 0;
+    bool day_full_ = false;        ///< the daily budget refused a write and none has fitted since
+    uint64_t day_refusals_ = 0;    ///< refusals since day_full_ was set
 };
 
 }  // namespace strata::core
diff --git a/src/core/conversation_disk.cpp b/src/core/conversation_disk.cpp
index c899e15d..7f101d01 100644
--- a/src/core/conversation_disk.cpp
+++ b/src/core/conversation_disk.cpp
@@ -6,6 +6,7 @@
 #include <cstdarg>
 #include <cstdio>
 #include <cstring>
+#include <ctime>
 #include <exception>
 #include <filesystem>
 #include <fstream>
@@ -447,9 +448,11 @@ bool ConversationDiskTier::put_body(SavedConversation&& image) {
     uint64_t queued_bytes = 0;
     const uint64_t estimate = job.entry.bytes;
     const char* why = nullptr;   // xrig tier fix: the write gate's refusal, if any
+    std::string note;
+    bool quiet = false;
     {
         std::lock_guard<std::mutex> lock(m_);
-        why = write_gate(job.entry.live, job.entry.cvec, estimate);
+        why = write_gate(job.entry.live, job.entry.cvec, estimate, note, quiet);
         if (!why) {
             job.entry.id = ++next_id_;
             queue_.push_back(std::move(job));
@@ -458,8 +461,9 @@ bool ConversationDiskTier::put_body(SavedConversation&& image) {
             for (const auto& j : queue_) queued_bytes += j.entry.bytes;
         }
     }
+    if (!note.empty()) try { log(note); } catch (...) {}
     if (why) {   // not written: the caller drops it, as for a refused write (write_gate counted it)
-        try { log(fmt("not written: %zu tokens, %.0f MiB (%s)", tokens, mib(estimate), why)); } catch (...) {}
+        if (!quiet) try { log(fmt("not written: %zu tokens, %.0f MiB (%s)", tokens, mib(estimate), why)); } catch (...) {}
         return false;
     }
     cv_.notify_all();
@@ -554,12 +558,16 @@ bool ConversationDiskTier::put_streamed(SavedConversation& meta,
     }
     {
         std::unique_lock<std::mutex> lock(m_);
-        if (const char* why = write_gate(e.live, e.cvec, e.bytes)) {
-            lock.unlock();
-            log(fmt("not written: %zu tokens, %.0f MiB, streamed (%s)", e.live.ids.size(), mib(e.bytes), why));
+        std::string note;
+        bool quiet = false;
+        const char* why = write_gate(e.live, e.cvec, e.bytes, note, quiet);
+        if (!why) e.id = ++next_id_;
+        lock.unlock();
+        if (!note.empty()) log(note);
+        if (why) {
+            if (!quiet) log(fmt("not written: %zu tokens, %.0f MiB, streamed (%s)", e.live.ids.size(), mib(e.bytes), why));
             return false;
         }
-        e.id = ++next_id_;
     }
     std::vector<SavedConversation> parts = std::move(meta.stage_images);
     meta.stage_images.clear();
@@ -853,7 +861,22 @@ static bool same_state(const ConversationCheckpoint& a, const ConversationCheckp
     return !a.ids.empty() && a.ids == b.ids && a.imgs == b.imgs;
 }
 
-const char* ConversationDiskTier::write_gate(const ConversationCheckpoint& live, bool cvec, uint64_t bytes) {
+// Local wall-clock HH:MM of a steady_clock time (for a notice a person reads).
+static std::string clock_of(std::chrono::steady_clock::time_point t) {
+    const auto wall = std::chrono::system_clock::now() +
+                      std::chrono::duration_cast<std::chrono::system_clock::duration>(t - std::chrono::steady_clock::now());
+    const std::time_t tt = std::chrono::system_clock::to_time_t(wall);
+    std::tm tm{};
+    char buf[16] = "?";
+    if (localtime_r(&tt, &tm)) std::strftime(buf, sizeof buf, "%H:%M", &tm);
+    return buf;
+}
+
+// One line per this many refusals while the daily budget is full (the first one is always logged).
+static constexpr uint64_t kDayRefusalLogEvery = 100;
+
+const char* ConversationDiskTier::write_gate(const ConversationCheckpoint& live, bool cvec, uint64_t bytes,
+                                             std::string& note, bool& quiet) {
     if (options_.min_write_tokens && live.ids.size() < options_.min_write_tokens) {
         ++stats_.skipped_short;
         return "under the minimum tokens for a write";
@@ -880,8 +903,25 @@ const char* ConversationDiskTier::write_gate(const ConversationCheckpoint& live,
         }
         if (day_bytes_ + bytes > options_.day_write_bytes) {
             ++stats_.skipped_day;
+            if (!day_full_) {   // xrig: say once that the guard engaged, and until when at the earliest
+                day_full_ = true;
+                day_refusals_ = 0;
+                note = fmt("daily write budget reached (%.0f of %.0f MiB written in the last 24 h): conversations "
+                           "stay in RAM only, not written to the disk, until room frees (at the earliest %s, when "
+                           "the oldest write leaves the 24 h window); refusals are logged 1 in %llu",
+                           mib(day_bytes_), mib(options_.day_write_bytes),
+                           day_writes_.empty() ? "now" : clock_of(day_writes_.front().first + std::chrono::hours(24)).c_str(),
+                           (unsigned long long) kDayRefusalLogEvery);
+            }
+            quiet = day_refusals_++ % kDayRefusalLogEvery != 0;
             return "over the daily write budget";
         }
+        if (day_full_) {
+            day_full_ = false;
+            note = fmt("daily write budget has room again (%.0f of %.0f MiB in the last 24 h): writing to the disk "
+                       "resumes after %llu refused write%s", mib(day_bytes_), mib(options_.day_write_bytes),
+                       (unsigned long long) day_refusals_, day_refusals_ == 1 ? "" : "s");
+        }
         day_writes_.emplace_back(now, bytes);
         day_bytes_ += bytes;
     }
diff --git a/src/core/conversation_disk_test.cpp b/src/core/conversation_disk_test.cpp
index aa2b213a..5bade592 100644
--- a/src/core/conversation_disk_test.cpp
+++ b/src/core/conversation_disk_test.cpp
@@ -138,6 +138,12 @@ bool logged(const char* what) {
     for (const auto& l : lines) if (l.find(what) != std::string::npos) return true;
     return false;
 }
+size_t count_logged(const char* what) {
+    std::lock_guard<std::mutex> g(lines_m);
+    size_t n = 0;
+    for (const auto& l : lines) n += l.find(what) != std::string::npos;
+    return n;
+}
 }  // namespace
 
 int main() {
@@ -630,9 +636,10 @@ int main() {
     }
 
     {   // xrig tier fix: the daily write budget
-        const uint64_t one = image(400, 58).bytes();
+        const uint64_t one = image(400, 58).bytes(), small = image(100, 250, 9000).bytes();
+        check(small < one, "day budget: a 100-token image is smaller than a 400-token one");
         auto o = opts(dir, GiB);
-        o.day_write_bytes = one * 2 + one / 2;   // room for two
+        o.day_write_bytes = one * 2 + small;   // room for two, and then only for the small one
         ConversationDiskTier tier(std::move(o));
         check(tier.open(e) && tier.put(image(400, 58, 1000)) && tier.put(image(400, 59, 3000)),
               "day budget: two writes fit");
@@ -640,6 +647,17 @@ int main() {
               "day budget: the third is not written, counted and logged");
         tier.wait_idle();
         check(tier.size() == 2, "day budget: two entries on the disk");
+        check(count_logged("daily write budget reached") == 1 && logged("at the earliest "),
+              "day budget: one notice that the budget is reached, with the earliest time");
+        const size_t refused_lines = count_logged("over the daily write budget");
+        for (int i = 0; i < 150; ++i) tier.put(image(400, uint8_t(61 + i), 7000 + 2 * i));
+        check(tier.stats().skipped_day == 151 && count_logged("over the daily write budget") == refused_lines + 1 &&
+                  count_logged("daily write budget reached") == 1,
+              "day budget: 150 more refusals log one line (1 in 100) and no second notice");
+        check(tier.put(image(100, 250, 9000)) && logged("daily write budget has room again") &&
+                  logged("resumes after 151 refused writes"),
+              "day budget: a write that fits again is written, with a notice");
+        tier.wait_idle();
         tier.clear();
     }
 
-- 
