+    }
+
+    {   // xrig hardening: an index naming a file outside the folder (absolute or "..") is refused, and that file stays
+        auto persistent5 = [&] {
+            auto o = opts(dir, GiB);
+            o.persist = true;
+            o.identity = {5, 7};
+            return o;
+        };
