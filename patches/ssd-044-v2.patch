+            {
+                ConversationDiskTier tier(persistent5());
+                check(tier.open(e) && tier.put(image(300, 25)), "hardening: put");
+            }
+            for (const auto& f : fs::directory_iterator(dir)) {
+                if (f.path().extension() != ".idx") continue;
